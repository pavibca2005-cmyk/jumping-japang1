<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Super Jump Adventure</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #151530;
    color: white;
    text-align: center;
}

h1 {
    padding: 15px;
    color: #ffeb3b;
}

#game {
    position: relative;
    width: 90%;
    max-width: 900px;
    height: 400px;
    margin: 10px auto;
    overflow: hidden;
    background: linear-gradient(#55c7ff, #d9f6ff);
    border: 4px solid white;
    border-radius: 10px;
}

#score {
    position: absolute;
    top: 12px;
    left: 12px;
    color: #111;
    font-size: 20px;
    font-weight: bold;
    z-index: 5;
}

#player {
    position: absolute;
    width: 35px;
    height: 45px;
    left: 60px;
    bottom: 55px;
    background: #ef3038;
    border: 3px solid #8b1118;
    border-radius: 8px 8px 3px 3px;
    z-index: 2;
}

#player::before {
    content: "";
    position: absolute;
    width: 25px;
    height: 13px;
    background: #ffd4a3;
    border-radius: 6px;
    top: 7px;
    left: 2px;
}

#player::after {
    content: "";
    position: absolute;
    width: 30px;
    height: 8px;
    background: #173b91;
    bottom: -3px;
    left: 0;
    border-radius: 2px;
}

#ground {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 55px;
    background: repeating-linear-gradient(
        90deg,
        #39b54a 0px,
        #39b54a 35px,
        #258331 35px,
        #258331 40px
    );
    border-top: 6px solid #8bdf58;
}

.obstacle {
    position: absolute;
    bottom: 55px;
    width: 30px;
    height: 35px;
    background: #795548;
    border: 3px solid #4e342e;
    border-radius: 5px;
}

.coin {
    position: absolute;
    width: 22px;
    height: 22px;
    background: #ffdf00;
    border: 3px solid #e49b00;
    border-radius: 50%;
    bottom: 120px;
}

#message {
    position: absolute;
    top: 40%;
    width: 100%;
    color: #111;
    font-size: 27px;
    font-weight: bold;
    display: none;
    z-index: 10;
}

button {
    padding: 12px 24px;
    margin: 8px;
    background: #ffcc00;
    border: none;
    border-radius: 8px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #ff9900;
}

.controls {
    padding: 10px;
    line-height: 1.8;
}

#mobileControls button {
    min-width: 65px;
    font-size: 22px;
    touch-action: none;
}

@media (max-width: 500px) {
    #game {
        width: 96%;
        height: 350px;
    }

    h1 {
        font-size: 24px;
    }
}
</style>
</head>

<body>

<h1>🍄 Super Jump Adventure</h1>

<div id="game">
    <div id="score">Score: 0</div>
    <div id="player"></div>
    <div id="ground"></div>
    <div id="message"></div>
</div>

<button id="startBtn">Start Game</button>
<button id="restartBtn">Restart</button>

<div class="controls">
    <p>⬅️ ➡️ Move | ⬆️ / SPACE Jump</p>
    <p>Collect coins and avoid obstacles!</p>
</div>

<div id="mobileControls">
    <button id="leftBtn">⬅️</button>
    <button id="jumpBtn">⬆️</button>
    <button id="rightBtn">➡️</button>
</div>

<script>
const game = document.getElementById("game");
const player = document.getElementById("player");
const scoreText = document.getElementById("score");
const message = document.getElementById("message");

let playerX = 60;
let playerY = 55;
let velocityY = 0;
let score = 0;
let running = false;
let onGround = true;
let obstacles = [];
let coins = [];
let keys = {};
let lastObstacle = 0;
let lastCoin = 0;
let animationId = null;
let previousTime = 0;

const playerWidth = 35;
const playerHeight = 45;
const groundHeight = 55;
const gravity = 1500;
const jumpPower = 550;
const moveSpeed = 260;

function createObstacle() {
    const obstacle = document.createElement("div");
    obstacle.className = "obstacle";

    const x = game.clientWidth + 10;
    obstacle.style.left = x + "px";

    game.appendChild(obstacle);
    obstacles.push({
        element: obstacle,
        x: x,
        width: 30,
        height: 35
    });
}

function createCoin() {
    const coin = document.createElement("div");
    coin.className = "coin";

    const x = game.clientWidth + 10;
    const y = 100 + Math.random() * 70;

    coin.style.left = x + "px";
    coin.style.bottom = y + "px";

    game.appendChild(coin);
    coins.push({
        element: coin,
        x: x,
        y: y,
        collected: false
    });
}

function jump() {
    if (running && onGround) {
        velocityY = jumpPower;
        onGround = false;
    }
}

function intersects(a, b) {
    return (
        a.left < b.right &&
        a.right > b.left &&
        a.top < b.bottom &&
        a.bottom > b.top
    );
}

function endGame() {
    running = false;
    message.innerHTML =
        "GAME OVER!<br>Final Score: " + score;
    message.style.display = "block";
    cancelAnimationFrame(animationId);
}

function update(dt, time) {
    if (keys["ArrowLeft"] || keys["a"] || keys["A"]) {
        playerX -= moveSpeed * dt;
    }

    if (keys["ArrowRight"] || keys["d"] || keys["D"]) {
        playerX += moveSpeed * dt;
    }

    playerX = Math.max(
        0,
        Math.min(game.clientWidth - playerWidth, playerX)
    );

    if (!onGround) {
        playerY += velocityY * dt;
        velocityY -= gravity * dt;

        if (playerY <= groundHeight) {
            playerY = groundHeight;
            velocityY = 0;
            onGround = true;
        }
    }

    player.style.left = playerX + "px";
    player.style.bottom = playerY + "px";

    if (time - lastObstacle > 1700) {
        createObstacle();
        lastObstacle = time;
    }

    if (time - lastCoin > 1200) {
        createCoin();
        lastCoin = time;
    }

    const playerRect = player.getBoundingClientRect();

    obstacles.forEach((obstacle, index) => {
        obstacle.x -= 220 * dt;
        obstacle.element.style.left = obstacle.x + "px";

        const rect = obstacle.element.getBoundingClientRect();

        if (intersects(playerRect, rect)) {
            endGame();
        }

        if (obstacle.x < -obstacle.width) {
            obstacle.element.remove();
            obstacles.splice(index, 1);
            score += 1;
        }
    });

    coins.forEach((coin, index) => {
        coin.x -= 220 * dt;
        coin.element.style.left = coin.x + "px";

        const rect = coin.element.getBoundingClientRect();

        if (!coin.collected && intersects(playerRect, rect)) {
            coin.collected = true;
            coin.element.remove();
            coins.splice(index, 1);
            score += 10;
        } else if (coin.x < -25) {
            coin.element.remove();
            coins.splice(index, 1);
        }
    });

    scoreText.textContent = "Score: " + score;
}

function gameLoop(time) {
    if (!running) return;

    const dt = Math.min((time - previousTime) / 1000 || 0, 0.03);
    previousTime = time;

    update(dt, time);

    if (running) {
        animationId = requestAnimationFrame(gameLoop);
    }
}

function startGame() {
    cancelAnimationFrame(animationId);

    obstacles.forEach(item => item.element.remove());
    coins.forEach(item => item.element.remove());

    obstacles = [];
    coins = [];
    keys = {};

    playerX = 60;
    playerY = groundHeight;
    velocityY = 0;
    score = 0;
    onGround = true;
    running = true;

    lastObstacle = performance.now();
    lastCoin = performance.now();
    previousTime = performance.now();

    player.style.left = playerX + "px";
    player.style.bottom = playerY + "px";

    message.style.display = "none";

    animationId = requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown", event => {
    if ([
        "ArrowLeft", "ArrowRight",
        "ArrowUp", " "
    ].includes(event.key)) {
        event.preventDefault();
    }

    keys[event.key] = true;

    if (
        event.key === "ArrowUp" ||
        event.key === " "
    ) {
        jump();
    }
});

document.addEventListener("keyup", event => {
    keys[event.key] = false;
});

function holdButton(buttonId, key) {
    const button = document.getElementById(buttonId);

    button.addEventListener("pointerdown", event => {
        event.preventDefault();
        keys[key] = true;

        if (key === "ArrowUp") {
            jump();
        }
    });

    ["pointerup", "pointerleave", "pointercancel"].forEach(type => {
        button.addEventListener(type, () => {
            keys[key] = false;
        });
    });
}

holdButton("leftBtn", "ArrowLeft");
holdButton("rightBtn", "ArrowRight");
holdButton("jumpBtn", "ArrowUp");

document.getElementById("startBtn").addEventListener(
    "click", startGame
);

document.getElementById("restartBtn").addEventListener(
    "click", startGame
);
</script>

</body>
</html>
